# Identity Service - Backend Environment Configuration
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to version control!

# JWT Secret Key (same value must be in iris-svm-api and all other services).
# Để trống có chủ ý: dịch vụ sẽ không khởi động cho đến khi bạn tạo khóa riêng, vì
# repo này public nên mọi giá trị mẫu đều ai cũng biết. Tạo khóa bằng:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Comma-separated list of allowed client_id values
CLIENT_IDS=iris-svm-api,breast-cancer-api

# CORS origins (comma-separated list of frontend URLs)
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

# Fixed Owner Account (Tài khoản chủ sở hữu cố định duy nhất của hệ thống)
OWNER_EMAIL=admin@ml-dl-ai.local
# Để trống thì tài khoản chủ sở hữu bị tắt. Dùng mật khẩu dài (16+ ký tự), ngẫu nhiên,
# không dùng lại ở nơi khác. Không dùng mật khẩu mặc định từng xuất hiện trong repo.
OWNER_PASSWORD=

# Database URL (defaults to local SQLite if not set). Trên Render nên dùng Postgres
# để không mất tài khoản mỗi lần khởi động lại, ví dụ:
#   IDP_DATABASE_URL=postgresql://user:password@host:5432/dbname
IDP_DATABASE_URL=sqlite:///./identity.db

# Port (local only; Render auto-provides $PORT)
PORT=8001
