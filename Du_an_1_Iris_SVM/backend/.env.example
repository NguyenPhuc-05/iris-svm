# Iris SVM Backend - Environment Configuration
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env to version control!

# JWT Secret Key (must match the identity_service JWT_SECRET EXACTLY).
# Để trống có chủ ý: dùng đúng khóa riêng của identity_service, không dùng giá trị mẫu.
JWT_SECRET=

# This service's client_id (must be registered in identity_service CLIENT_IDS)
CLIENT_ID=iris-svm-api

# Database URL for prediction history (defaults to SQLite fallback)
DATABASE_URL=sqlite:///./iris_fallback.db

# CORS frontend origins
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5500,http://127.0.0.1:5500

